<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.alchembright.dev.langtrackapp.screen.surveyContainer.SurveyContainerViewModel"/>
    </data>

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screen.surveyContainer.SurveyContainerActivity"
    android:id="@+id/surveyContainer_layout">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/surveyToolbar" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="?attr/actionBarSize" android:background="@color/kirokun_brand" app:title="@string/langTrackApp" app:titleTextColor="@android:color/white" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/surveyHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/kirokun_surface_alternate" android:textColor="@color/lta_text" android:textSize="16sp" android:padding="12dp" app:layout_constraintTop_toBottomOf="@id/surveyToolbar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <FrameLayout android:id="@+id/surveyContainer" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/surveyHeading" />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>